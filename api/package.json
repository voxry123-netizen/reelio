{
  "name": "@reelio/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "seed": "node --enable-source-maps dist/seed.js",
    "start:api": "node --enable-source-maps dist/index.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "start:api:docker": "sh -c \"pnpm prisma db push && pnpm seed && node --enable-source-maps dist/index.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/s3-request-presigner": "^3.645.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^5.19.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.12.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.1",
    "@fastify/websocket": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^2.0.16"
  }
}